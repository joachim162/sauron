#
# ignoring needless cruft
#

# from any directory
**/*.orig
**/*.dist
**/*dist
**/*.save
**/*~
*.tar.gz
*.zip
*.env

# year-and-date-ending
**/*[.-]20??-??-??

# configured Sauron
Sauron/DB.pm
modgroup

# GNU configure generated stuff
config.log
config.status

# after instalation (./configure ; make)
Makefile
config.h
doc/tables.html
doc/tables.sgml

# dot files
.*

# don't ignore (yourself, github, ...)
!.gitignore
!.github/

# Sauron API
sauron_api/sauron_a_p_i.yml

# keys
*.key
*.crt

# openssl config for dev cert generation
server.cnf
# eof
